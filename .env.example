# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Auth: local JWT always available; Azure AD SSO optional ---
JWT_SECRET=change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Azure AD SSO — leave both blank to disable SSO (local auth still works).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Team new SSO users are auto-onboarded into on first login.
DEFAULT_TEAM_ID=default-team

# --- Postgres ---
# One DSN used for both the app's own tables and LangGraph's checkpoint tables by default
# (different table names, no collision). Set CHECKPOINT_DATABASE_URL separately if you
# want them on physically different databases/instances.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orchestrator?sslmode=disable
CHECKPOINT_DATABASE_URL=

# --- LLM generation: "bedrock" (default at this tier) or "openai" ---
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Orchestrator ---
MAX_TURNS=8
